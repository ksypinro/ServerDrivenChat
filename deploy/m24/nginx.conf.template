server {
    listen 80;
    server_name ${SDC_DOMAIN};
    return 308 https://${SDC_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SDC_DOMAIN};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SDCSSL:10m;
    ssl_session_timeout 10m;

    # Docker service addresses can change during upgrades; resolve them at request time.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $sdc_gateway http://gateway:8000;
    set $sdc_server http://server:3000;

    server_tokens off;
    if ($host != ${SDC_DOMAIN}) { return 444; }
    client_max_body_size 11m;
    client_body_timeout 15s;
    send_timeout 1h;
    access_log off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location ~ ^/(api/v1|openai/v1|anthropic/v1)(/|$) {
        proxy_pass $sdc_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 5s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass $sdc_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 5s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Accel-Buffering no always;
    }
}
