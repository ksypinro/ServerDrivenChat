FROM python:3.13.16-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1
RUN pip install --no-cache-dir uv==0.12.23
WORKDIR /app
COPY api-gateway/pyproject.toml api-gateway/uv.lock ./
COPY api-gateway/sdc_gateway ./sdc_gateway
RUN uv sync --locked --no-dev --no-install-project
ENV PATH="/app/.venv/bin:$PATH" SDC_GATEWAY_HOST=0.0.0.0 SDC_GATEWAY_PORT=8000
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=4 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=2)"
CMD ["python", "-m", "sdc_gateway"]
