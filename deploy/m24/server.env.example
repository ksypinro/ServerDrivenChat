# Store as /srv/sdc/server.env with mode 0600 and operator-controlled ownership.
# Compose supplies DATABASE_URL here; URL-encode reserved characters in the password.
DATABASE_URL=postgres://sdc_app:URL_ENCODED_PASSWORD@postgres:5432/sdc
SDC_OIDC_ISSUER=https://identity.example.invalid/realms/sdc
SDC_OIDC_CLIENT_ID=sdc-native
SDC_OIDC_API_AUDIENCE=sdc-api
SDC_OIDC_REDIRECT_URIS=vscode://server-driven-chat.sdc-cline-bridge/auth
SDC_DATABASE_POOL_SIZE=20
# Leave unset/empty by default. Add only reviewed exact {bindingId,evidence} entries after real native qualification.
SDC_PUBLIC_API_TOOL_BINDINGS_JSON=[]
